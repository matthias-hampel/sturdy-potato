# Aerial imagery tiles. Esri World Imagery is used by default for development;
# production needs a licensed imagery provider.
# VITE_SATELLITE_TILES=https://example.com/tiles/{z}/{y}/{x}
# VITE_SATELLITE_ATTRIBUTION=Imagery © Provider
# API the dev server proxies /api to.
# AGMEO_API_URL=http://localhost:3001
