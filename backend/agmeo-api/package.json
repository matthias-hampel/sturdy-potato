{
  "name": "@agmeo/api",
  "version": "0.0.1",
  "description": "agmeo farm management API (NestJS)",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "start:worker": "node --env-file-if-exists=.env dist/worker.js",
    "sync:bsa": "node --env-file-if-exists=.env dist/bsa-sync.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:types": "kysely-codegen --dialect postgres --url \"${DATABASE_URL_MIGRATE:-postgres://agmeo_owner:agmeo_owner@localhost:5434/agmeo}\" --out-file src/db/schema.ts --include-pattern \"public.*\" --exclude-pattern \"public.(spatial_ref_sys|geography_columns|geometry_columns|schema_migrations)\" --date-parser string --numeric-parser number",
    "seed": "node --env-file-if-exists=.env dist/seed.js",
    "sync:psm": "node --env-file-if-exists=.env dist/psm-sync.js"
  },
  "dependencies": {
    "@agmeo/contracts": "workspace:*",
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "openai": "^7.36.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "xml": "^1.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@types/xml": "^1.0.11",
    "@vitest/coverage-v8": "^4.1.2",
    "kysely-codegen": "^0.20.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2",
    "xmllint-wasm": "^5.3.0"
  }
}
