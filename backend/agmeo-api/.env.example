# Defaults match docker-compose.yml; copy to .env to override.
PORT=3001
DATABASE_URL=postgres://agmeo_api:agmeo_api@localhost:5434/agmeo
RELAY_DATABASE_URL=postgres://agmeo_worker:agmeo_worker@localhost:5434/agmeo
JOBS_DATABASE_URL=postgres://agmeo_jobs_worker:agmeo_jobs_worker@localhost:5434/agmeo
RECOMMENDER_DATABASE_URL=postgres://agmeo_recommender_worker:agmeo_recommender_worker@localhost:5434/agmeo
NATS_URL=nats://localhost:4222
CORS_ORIGIN=http://localhost:3000
# Public URL of the web app, for links in e-mails.
APP_URL=http://localhost:3000

# Sign-in: 'oidc' verifies Keycloak tokens (production); 'dev' accepts any e-mail without a
# password (tests, offline development; refused with NODE_ENV=production).
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-to-a-long-random-string
OIDC_ISSUER=http://localhost:8180/realms/agmeo
OIDC_AUDIENCE=agmeo-api
OIDC_WEB_CLIENT_ID=agmeo-web

# E-mail (Mailpit locally: web UI on http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=agmeo <no-reply@agmeo.local>

# File storage: 'local' (directory) or 's3' (any S3-compatible bucket).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_DEFAULT_LIMIT_GB=5
STORAGE_MAX_UPLOAD_MB=1024
# S3_BUCKET=agmeo
# S3_REGION=eu-central
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Open-Meteo subscription key (customer endpoints, ERA5 archive for season backfills of stored weather).
# Without it the free API is used, which is for development only and reaches back 92 days.
OPEN_METEO_API_KEY=

# Thünen AgriGHG tool (RothC soil-carbon simulation on the field's carbon tab).
# THUENEN_BASE_URL=https://agrighg-tool.thuenen.de/api/v1
THUENEN_API_KEY=
# Maize dry-matter monitoring: AGVOLUTION's maize-dmc-api (in-cluster service URL in production,
# e.g. http://maize-dmc-api.<namespace>.svc:8000). Leave the URL empty to switch the feature off:
# the page shows "not configured", forecast routes answer 503 dmc_not_configured, the harvest
# detection job skips itself.
MAIZE_DMC_API_URL=
# Bearer token of the service (its DMC_API_TOKEN); empty sends no Authorization header.
MAIZE_DMC_API_TOKEN=
# Timeout per predict attempt in ms (5xx and network errors are retried twice).
MAIZE_DMC_API_TIMEOUT_MS=120000
# 'off' stops sending our stored daily weather with each forecast (the service then fetches all of it).
DMC_SUPPLY_CACHED_WEATHER=on
# 'off' evaluates the silage harvest probability on the uncorrected model DM.
DMC_HARVEST_P_CORRECTION=on
# AGVOLUTION model services. Each one stays off while its URL / credentials are empty: the API
# answers `configured: false` (reads) or 503 `service_not_configured` (requests that would call
# it), the worker skips its jobs and the app shows a notice.
#
# ESM (ecosystem model server, lvl0-models esm/endpoints): zone yields and nitrogen terms for the
# zone optimisation (POST /esm/run?sync=true) and the crop timeseries (GET /results/<year>/<crop
# cycle id>/timeseries.json). The ESM verifies the bearer token with the reference app's Clerk
# instance, so ESM_API_TOKEN must be a token it accepts (e.g. a Clerk API key).
ESM_SERVER_URL=
ESM_API_TOKEN=
# Host the ESM worker posts its writeback to. "localhost" makes the ESM host skip the writeback;
# this API takes the zones from the sync response instead.
# ESM_WRITEBACK_DOMAIN=localhost
# ESM_RUN_TIMEOUT_MS=330000
# ESM_TIMEOUT_MS=30000

# grassland-api (POST /grassland/predict): grassland growth predictions. The token is optional.
GRASSLAND_API_URL=
GRASSLAND_API_TOKEN=
# GRASSLAND_API_TIMEOUT_MS=120000

# ISIP disease models (isip.de, Keycloak password grant), fetched daily 06:00 UTC from Feb 15 to
# Jun 30 for winter wheat, winter/spring barley, winter rye and triticale. Disease risk is off
# while username, password or client secret is empty.
ISIP_USERNAME=
ISIP_PASSWORD=
ISIP_CLIENT_SECRET=
# ISIP_CLIENT_ID=sso-api-client-extern
# ISIP_API_URL=https://www.isip.de/charts/api
# ISIP_TOKEN_URL=https://login.isip.de/auth/realms/ams/protocol/openid-connect/token
# ISIP_TIMEOUT_MS=60000
# Field recommendations: an OpenAI model phrases the reasons (optional; without a key the UI
# shows the reasons from the rule set's evidence). Field and crop names are sent to OpenAI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
# The worker recalculates recommendations daily at this local time and after changes to
# operations or crop cycles; RECOMMENDATIONS_SCHEDULE=off disables both.
# RECOMMENDATIONS_SCHEDULE=on
# RECOMMENDATIONS_DAILY_AT=05:00
# RECOMMENDATIONS_TIME_ZONE=Europe/Berlin
