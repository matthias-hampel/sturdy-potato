# Defaults match docker-compose.yml; copy to .env to override.
PORT=3001
DATABASE_URL=postgres://agmeo_api:agmeo_api@localhost:5434/agmeo
RELAY_DATABASE_URL=postgres://agmeo_worker:agmeo_worker@localhost:5434/agmeo
NATS_URL=nats://localhost:4222
CORS_ORIGIN=http://localhost:3000
# Development sign-in (no passwords). Replaced by OIDC/Keycloak later.
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-to-a-long-random-string
# Field recommendations: an OpenAI model phrases the reasons (optional; without a key the UI
# shows the reasons from the rule set's evidence). Field and crop names are sent to OpenAI.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
