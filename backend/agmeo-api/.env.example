# Defaults match docker-compose.yml; copy to .env to override.
PORT=3001
DATABASE_URL=postgres://agmeo_api:agmeo_api@localhost:5434/agmeo
RELAY_DATABASE_URL=postgres://agmeo_worker:agmeo_worker@localhost:5434/agmeo
JOBS_DATABASE_URL=postgres://agmeo_jobs_worker:agmeo_jobs_worker@localhost:5434/agmeo
NATS_URL=nats://localhost:4222
CORS_ORIGIN=http://localhost:3000
# Public URL of the web app, for links in e-mails.
APP_URL=http://localhost:3000

# Sign-in: 'oidc' verifies Keycloak tokens (production); 'dev' accepts any e-mail without a
# password (tests, offline development; refused with NODE_ENV=production).
AUTH_MODE=dev
DEV_AUTH_SECRET=change-me-to-a-long-random-string
OIDC_ISSUER=http://localhost:8180/realms/agmeo
OIDC_AUDIENCE=agmeo-api
OIDC_WEB_CLIENT_ID=agmeo-web

# E-mail (Mailpit locally: web UI on http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=agmeo <no-reply@agmeo.local>

# File storage: 'local' (directory) or 's3' (any S3-compatible bucket).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_DEFAULT_LIMIT_GB=5
STORAGE_MAX_UPLOAD_MB=1024
# S3_BUCKET=agmeo
# S3_REGION=eu-central
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Open-Meteo subscription key (customer endpoints, ERA5 archive for season backfills of stored weather).
# Without it the free API is used, which is for development only and reaches back 92 days.
OPEN_METEO_API_KEY=

# Maize dry-matter monitoring: AGVOLUTION's maize-dmc-api (in-cluster service URL in production,
# e.g. http://maize-dmc-api.<namespace>.svc:8000). Leave the URL empty to switch the feature off:
# the page shows "not configured", forecast routes answer 503 dmc_not_configured, the harvest
# detection job skips itself.
MAIZE_DMC_API_URL=
# Bearer token of the service (its DMC_API_TOKEN); empty sends no Authorization header.
MAIZE_DMC_API_TOKEN=
# Timeout per predict attempt in ms (5xx and network errors are retried twice).
MAIZE_DMC_API_TIMEOUT_MS=120000
# 'off' stops sending our stored daily weather with each forecast (the service then fetches all of it).
DMC_SUPPLY_CACHED_WEATHER=on
# 'off' evaluates the silage harvest probability on the uncorrected model DM.
DMC_HARVEST_P_CORRECTION=on
